opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build iOS App and upload to TestFlight"
  lane :beta do
    # App Store Connect API Token
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    # Temporary Keychain for CI Runner
    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "password"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # On macOS, the created keychain has a -db suffix
    kc_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    kc_path = File.expand_path("~/Library/Keychains/#{keychain_name}") unless File.exist?(kc_path)

    # Fetch or create Apple Distribution Certificate and import into keychain
    get_certificates(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: keychain_password
    )

    # Allow codesign tool to access keychain without GUI prompt
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{keychain_password} '#{kc_path}'")

    # Fetch or create Provisioning Profile for App Store / TestFlight
    profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.gigmake.app"
    )

    profile_name = ENV["SIGH_NAME"] || "com.gigmake.app AppStore"
    team_id = "8244GB6YJZ"

    # Configure Xcode code signing with downloaded profile and distribution certificate
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: team_id,
      targets: ["App"],
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution"
    )

    # Build the .ipa archive
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "GigMake.ipa",
      clean: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.gigmake.app" => profile_name
        }
      },
      xcargs: "DEVELOPMENT_TEAM='#{team_id}' PROVISIONING_PROFILE_SPECIFIER='#{profile_name}' CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution'"
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
