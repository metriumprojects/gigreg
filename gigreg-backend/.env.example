# Core Runtime
NODE_ENV=production
PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-64-char-random-secret

# Public Web & Admin Origins (CORS + Redirects + Reset Links)
FRONTEND_URL=https://gigmake.com
CLIENT_URL=https://gigmake.com
ADMIN_URL=https://admin.gigmake.com

# Stripe (use live keys & live webhook secret atomically in production)
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLIC_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Supported Connect payout countries are fetched dynamically from Stripe; set this optional comma-separated list to restrict them
# STRIPE_CONNECT_RESTRICT_COUNTRIES=

# Google OAuth & Maps
GOOGLE_CLIENT_IDS=192141687455-hg0udlcpo4s0akkhrnobhkmut80pg6lk.apps.googleusercontent.com
GOOGLE_GEOCODING_API_KEY=replace_with_restricted_google_maps_key
GOOGLE_PLACES_API_KEY=replace_with_restricted_google_places_key

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# SMTP Email
SMTP_SERVICE=gmail
SMTP_EMAIL=support@gigmake.com
SMTP_PASSWORD=replace_with_app_password
SMTP_FROM_NAME=GigMake

# Firebase Admin (base64-encoded service account JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=replace_me

# Optional: only set true in local dev if local ISP blocks MongoDB SRV DNS
# USE_CUSTOM_DNS=false
